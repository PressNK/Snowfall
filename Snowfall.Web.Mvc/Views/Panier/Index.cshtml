@model List<PanierItemViewModel>

@{
    ViewBag.Title = "Panier";
}

<h2>@ViewBag.Title</h2>

@foreach(PanierItemViewModel panierItem in Model ?? [])
{
    <partial name="_PanierItem" model="panierItem"/>
}

<div class="d-flex gap-2 mt-4">
    @if (Context.Session.GetString("panier") != null)
    {
        <a asp-controller="Achats" asp-action="Checkout" class="btn btn-success">Passer à la caisse</a>
    }
    <form asp-controller="Panier" asp-action="Delete">
        <button type="submit" class="btn btn-outline-danger">Vider le panier</button>
    </form>
</div>
