@model Snowfall.Web.Mvc.Models.Achats.CheckoutViewModel

@{
    ViewBag.Title = "Confirmer votre achat";
    Layout = "_Layout";
}

<h2 class="mb-4">Confirmer votre achat</h2>

<div class="row g-4">
    <!-- Informations client -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0">Informations de livraison</h5>
            </div>
            <div class="card-body">
                @if (Model.Utilisateur != null)
                {
                    <p><strong>Nom :</strong> @Model.Utilisateur.Prenom @Model.Utilisateur.Nom</p>
                    <p><strong>Courriel :</strong> @Model.Utilisateur.Email</p>
                    @if (Model.InformationClient != null)
                    {
                        <p><strong>Adresse :</strong> @Model.InformationClient.Adresse</p>
                        <p><strong>Ville :</strong> @Model.InformationClient.Ville, @Model.InformationClient.Province</p>
                        <p><strong>Code postal :</strong> @Model.InformationClient.CodePostal</p>
                        <p><strong>Pays :</strong> @Model.InformationClient.Pays</p>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Récapitulatif de la commande -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0">Récapitulatif de la commande</h5>
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Événement</th>
                            <th class="text-center">Qté</th>
                            <th class="text-end">Prix</th>
                            <th class="text-end">Sous-total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Evenement?.Nom</td>
                                <td class="text-center">@item.Quantite</td>
                                <td class="text-end">@item.Evenement?.Prix.ToString("C")</td>
                                <td class="text-end">@(((item.Evenement?.Prix ?? 0) * item.Quantite).ToString("C"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end"><strong>Sous-total</strong></td>
                            <td class="text-end">@Model.SousTotal.ToString("C")</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end"><strong>Livraison</strong></td>
                            <td class="text-end">@(Model.Livraison == 0 ? "Gratuite" : Model.Livraison.ToString("C"))</td>
                        </tr>
                        <tr class="table-primary">
                            <td colspan="3" class="text-end"><strong>Total</strong></td>
                            <td class="text-end"><strong>@Model.Total.ToString("C")</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-2 mt-4">
    <a asp-controller="Panier" asp-action="Index" class="btn btn-outline-secondary">Retour au panier</a>
    <form asp-controller="Achats" asp-action="Create">
        <button type="submit" class="btn btn-success">Confirmer l'achat</button>
    </form>
</div>

