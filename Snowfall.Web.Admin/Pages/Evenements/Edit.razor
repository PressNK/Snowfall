@page "/evenements/{id:int}/edit"
@using System.Net.Http.Headers
@using AutoMapper
@using Microsoft.Extensions.Localization
@using Snowfall.Application.Dtos.Evenements
@using Snowfall.Web.Admin.HttpClients
@using Snowfall.Web.Admin.Resources
@inject IStringLocalizer<Resources.Evenements.Edit> Localizer;
@inject IStringLocalizer<SharedResources> LocalizerShared;
@inject EvenementHttpClient EvenementHttpClient
@inject VilleHttpClient VilleHttpClient
@inject IMapper Mapper
@inject NavigationManager NavigationManager
@inject ToastService ToastService
@inject UploadHttpClient UploadHttpClient;

<h1>@Localizer["Titre"]</h1>

@if (_evenementDto == null)
{
    <p>Chargement...</p>
}
else
{
    <div class="col-lg-6">
        <EditForm Model="_modifierEvenementDto" OnValidSubmit="GererSubmit">
            <DataAnnotationsValidator />
            
            <div class="mb-3">
                @if (!string.IsNullOrEmpty(_modifierEvenementDto.ImagePath) || _modifying)
                {
                    @if (_modifying)
                    {
                        <label for="image" class="form-label">@Localizer["Image"]</label>
                        <InputFile id="image" class="form-control" accept=".jpg, .jpeg, .png" OnChange="@OnInputFileChange"/>
                        
                    }
                    else
                    {
                        <img src="/storage/@_modifierEvenementDto.ImagePath" class="card-img-top image-evenement" alt="@_modifierEvenementDto.Nom" />
                    }
                }
                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="RetirerImage">
                    <i class="bi bi-trash"></i> Retirer l'image
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ModifierImage">
                    <i class="bi bi-pencil"></i> Modifier l'image
                </button>
            </div>
            
            <div class="form-floating mb-3">
                <InputText id="nom" class="form-control" placeholder="Nom" @bind-Value="_modifierEvenementDto.Nom"/>
                <label asp-for="nom">Nom</label>
                <ValidationMessage class="invalid-feedback" For="@(() => _modifierEvenementDto.Nom)" />
            </div>
            <div class="form-floating mb-3">
                <InputTextArea id="description" rows="5" class="form-control" placeholder="Description" @bind-Value="_modifierEvenementDto.Description"/>
                <label asp-for="description">Description</label>
                <ValidationMessage class="invalid-feedback" For="@(() => _modifierEvenementDto.Description)" />
            </div>

            <div class="form-floating mb-3">
                <InputNumber id="capacite" class="form-control" placeholder="Capacité" ParsingErrorMessage=@LocalizerShared["CapaciteParsingErrorMessage"] @bind-Value="_modifierEvenementDto.Capacite"/>
                <label asp-for="capacite">Capacité</label>
                <ValidationMessage class="invalid-feedback" For="@(() => _modifierEvenementDto.Capacite)" />
            </div>
            <div class="form-floating mb-3">
                <InputDate id="date" class="form-control" placeholder="Date" @bind-Value="_modifierEvenementDto.Date"/>
                <label asp-for="date">Date</label>
                <ValidationMessage class="invalid-feedback" For="@(() => _modifierEvenementDto.Date)" />
            </div>
            <div class="form-floating mb-3">
                <InputNumber id="prix" class="form-control" placeholder="Prix" ParsingErrorMessage=@LocalizerShared["PrixParsingErrorMessage"] @bind-Value="_modifierEvenementDto.Prix"/>
                <label asp-for="prix">Prix</label>
                <ValidationMessage class="invalid-feedback" For="@(() => _modifierEvenementDto.Prix)" />
            </div>
            <div class="form-floating mb-3">
                <InputSelect id="ville" class="form-select" @bind-Value="_modifierEvenementDto.VilleId">
                    <option value="">Veuillez faire une sélection</option>
                    @if (_villes != null)
                    {
                        @foreach (var ville in _villes)
                        {
                            <option value="@ville.Id">@ville.Nom, @ville.PaysIso</option>
                        }
                    }
                </InputSelect>
                <label for="ville">Ville</label>
                <ValidationMessage class="invalid-feedback" For="@(() => _modifierEvenementDto.VilleId)" />
            </div>
            <button type="submit" class="btn btn-primary">@LocalizerShared["Bouton_Sauvegarder"]</button>
            <button class="btn btn-secondary" @onclick="Retour">@LocalizerShared["Bouton_Annuler"]</button>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }
    
    private EvenementDto? _evenementDto;
    private ModifierEvenementDto _modifierEvenementDto = new();
    private List<VilleDto>? _villes;
    private bool _modifying;
    
    protected override async Task OnInitializedAsync()
    {
        _villes = await VilleHttpClient.ObtenirVilles();
        (var statusCode, _evenementDto) = await EvenementHttpClient.ObtenirEvenement(Id);
        
        Mapper.Map(_evenementDto, _modifierEvenementDto);
    }
    
    async Task GererSubmit()
    {
        bool success = await EvenementHttpClient.ModifierEvenement(Id, _modifierEvenementDto);
        if (success)
        {
            ToastService.Notify(new(ToastType.Success, "L'événement a été modifié!"));
            NavigationManager.NavigateTo($"/evenements/{Id}");
        }
        else
        {
            ToastService.Notify(new(ToastType.Danger, "Une erreur est survenue!"));
        }
    }

    void Retour()
    {
        NavigationManager.NavigateTo($"/evenements/{Id}");
    }
    
    void RetirerImage()
    {
        _modifierEvenementDto.ImagePath = null;
        _modifying = false;
    }

    void ModifierImage()
    {
        _modifying = true;
    }

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        // La taille maximale acceptés pour les fichiers (5 Mo)
        long tailleFichierMax = 1024 * 1024 * 5;

        // Variable permettant de contrôler si on procède ou non au téléversement
        bool estPretPourUpload = false;

        // On crée le contenu du "formulaire" (body) envoyé
        using var content = new MultipartFormDataContent();

        try
        {
            // Le fichier est récupéré à partir de l'événement
            IBrowserFile file = e.File;

            // Le contenu du fichier est récupéré, avec comme limite tailleFichierMax
            var fileContent =
                new StreamContent(file.OpenReadStream(tailleFichierMax));

            // On assigne le bon type de fichier au contenu
            fileContent.Headers.ContentType =
                new MediaTypeHeaderValue(file.ContentType);

            // Le body de la requête qui sera envoyée
            content.Add(
                content: fileContent,
                name: "\"file\"",
                fileName: file.Name);

            // Aucune erreur, on peut procéder à l'upload
            estPretPourUpload = true;

            if (estPretPourUpload)
            {
                // On envoie le fichier à l'API
                var resultatUpload = await UploadHttpClient.Upload(content);
                if (resultatUpload != null)
                {
                    // Si l'upload a réussi, on assigne le chemin de l'image à l'événement en cours de création
                    _modifierEvenementDto.ImagePath = resultatUpload.NomFichier;
                    ToastService.Notify(new(ToastType.Success, "L'image a bien été téléversée."));
                }
                else
                {
                    ToastService.Notify(new(ToastType.Danger, "Une erreur est survenue lors du téléversement de l'image."));
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, "Impossible de lire le fichier. Vérifiez qu'il correspond bien à la taille maximale."));
        }
    }

}